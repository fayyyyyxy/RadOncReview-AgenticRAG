# ---------------------------------------------------------------
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Then open .env and replace each empty value with your own.
# Never commit .env to version control — it is already in .gitignore.
# ---------------------------------------------------------------

# AWS Identity
AWS_PROFILE_NAME=  # local dev only — set to your SSO profile name. App Runner: leave empty (uses IAM role).
AWS_REGION=

# S3
S3_BUCKET_NAME=

# DynamoDB
DYNAMODB_TABLE_NAME=

# Bedrock Knowledge Base
KB_ID=
KB_DATASOURCE_ID=

# FAISS index key in S3 (optional, default: radonc_faiss_index.bin)
FAISS_INDEX_KEY=

# Local dev only: set to true to skip AWS connection
USE_MOCK_AGENT=false
